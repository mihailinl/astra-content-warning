<?xml version="1.0" encoding="utf-8"?>
<!-- Public sources only: this project builds from the Astra SDK, BepInEx.Core and
     UnityEngine.Modules alone, never the game's own files (GAME-INTEGRATION-MANIFEST.md §6). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <!-- Uncomment to build against a LOCAL, unreleased Astra SDK (see GameDir.props.user, which
         adds the same path through RestoreAdditionalProjectSources — either is enough):
    <add key="astra-local" value="/home/mihailin/Documents/GitHub/astra-bepinex/artifacts/nuget" />
    -->
  </packageSources>
</configuration>
