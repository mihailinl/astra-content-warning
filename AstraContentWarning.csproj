<Project Sdk="Microsoft.NET.Sdk">
  <!-- Astra for Content Warning: a game integration on the Astra Unity foundation, built from
       PUBLIC inputs only (the Astra SDK, BepInEx.Core, UnityEngine.Modules) — never the game's own
       files. Every game type (Player, PlayerData, MainCamera, VideoCamera, Mirror) is reached by
       NAME at run time through Astra.Sdk.GameType (GAME-INTEGRATION-MANIFEST.md §6), so this
       project has no GameDir and no reference to the game's assemblies at all.
       The foundation is installed in the game once and updates by itself, so it is referenced
       COMPILE-ONLY here (ExcludeAssets="runtime") and never shipped with this plugin. -->
  <PropertyGroup>
    <!-- Unity 2021.2+ (netstandard2.1). A game on Unity 2021.1 or older: netstandard2.0. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AstraRuntime>unity-mono</AstraRuntime>
    <AstraLoader>bepinex5</AstraLoader>
    <AssemblyName>AstraContentWarning</AssemblyName>
    <RootNamespace>AstraContentWarning</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <BepInExPluginGuid>astra.content-warning</BepInExPluginGuid>
    <BepInExPluginName>Astra for Content Warning</BepInExPluginName>
    <Version>0.2.0</Version>
    <SteamAppId>2881650</SteamAppId>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- This machine only (git ignores it): the Astra SDK's LOCAL feed, for building against an
       unreleased foundation/SDK before it reaches NuGet. Never a game folder — this project no
       longer references one at all. -->
  <Import Project="GameDir.props.user" Condition="Exists('GameDir.props.user')" />

  <ItemGroup>
    <PackageReference Include="Astra.Unity.Sdk" Version="[0.5.0-dev1,1)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <!-- The installed-version marker the Astra client reads, beside the plugin. -->
  <Target Name="AstraItemMarker" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)astra-item.json" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="{&quot;id&quot;:&quot;$(BepInExPluginGuid)&quot;,&quot;version&quot;:&quot;$(Version)&quot;,&quot;kind&quot;:&quot;game-integration&quot;,&quot;runtime&quot;:&quot;$(AstraRuntime)&quot;,&quot;loader&quot;:&quot;$(AstraLoader)&quot;,&quot;steam_appid&quot;:$(SteamAppId)}" />
  </Target>
</Project>
